import { useState } from 'react';
import { View, Text, Pressable, StyleSheet } from 'react-native';

export default function App() {
  const [count, setCount] = useState(0);

  return (
    <View style={styles.container}>
      <Text style={styles.titre}>Bonjour Campus !</Text>
      <Text style={styles.sousTitre}>IAIL S5 - Simple Counter</Text>

      <Text style={styles.counter}>{count}</Text>

      <View style={styles.row}>
        <Pressable style={[styles.bouton, {backgroundColor: '#666'}]} onPress={() => setCount(count - 1)}>
          <Text style={styles.texteBouton}>-1</Text>
        </Pressable>

        <Pressable style={styles.bouton} onPress={() => setCount(count + 1)}>
          <Text style={styles.texteBouton}>+1</Text>
        </Pressable>
      </View>

      <Pressable style={[styles.bouton, {backgroundColor: '#E63946', marginTop: 15}]} onPress={() => setCount(0)}>
        <Text style={styles.texteBouton}>Reset</Text>
      </Pressable>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#F2F7FD', alignItems: 'center', justifyContent: 'center', padding: 20 },
  titre: { color: '#003796', fontSize: 26, fontWeight: 'bold' },
  sousTitre: { marginTop: 8, fontSize: 16 },
  counter: { fontSize: 64, fontWeight: 'bold', color: '#003796', marginVertical: 20 },
  row: { flexDirection: 'row', gap: 15 },
  bouton: { backgroundColor: '#003796', paddingVertical: 13, paddingHorizontal: 28, borderRadius: 9 },
  texteBouton: { color: '#fff', fontWeight: 'bold', fontSize: 18 }
});
